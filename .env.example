# Proxy URL (hides all secrets server-side)
VITE_PROXY_URL=https://arxiv-agent-proxy.your-subdomain.workers.dev

# Backend LangGraph server port (default: 2024)
VITE_BACKEND_PORT=2024

# AWS region for EC2 public DNS hostname (default: ap-southeast-1)
VITE_AWS_REGION=ap-southeast-1

# Graph/assistant ID to connect to (set automatically after backend starts)
VITE_ASSISTANT_ID=agent

# Optional: direct LangGraph server URL (skips access gate if set)
# VITE_API_URL=http://localhost
