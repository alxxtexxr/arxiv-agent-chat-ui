# Access keys (comma-separated) — validated client-side before starting backend
VITE_ALLOWED_KEYS=key1,key2,key3

# Admin keys (comma-separated subset of VITE_ALLOWED_KEYS) — enables stop button
VITE_ADMIN_KEYS=key1

# Instance control proxy URL (hides all secrets server-side)
VITE_INSTANCE_CONTROL_PROXY_URL=https://instance-control-proxy.your-subdomain.workers.dev

# Backend LangGraph server port (default: 2024)
VITE_BACKEND_PORT=2024

# Graph/assistant ID to connect to (set automatically after backend starts)
VITE_ASSISTANT_ID=agent

# Optional: direct LangGraph server URL (skips access gate if set)
# VITE_API_URL=http://localhost

# Optional: LangSmith API key (only needed for deployed LangGraph servers)
# VITE_LANGSMITH_API_KEY=lsv2_pt_...
